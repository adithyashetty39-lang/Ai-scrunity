# Select: none | gemini | openai | anthropic | openai_compatible | local
# Restart the backend after changes. Never commit real credentials.
SCRUTINY_AI_PROVIDER=none

# One shared cloud configuration. Use a model ID available to your account.
SCRUTINY_AI_KEY=
SCRUTINY_AI_MODEL=

# Only required for openai_compatible; include the API version path, e.g. /v1.
SCRUTINY_AI_BASE_URL=
# Set true only for a model that accepts images. Required for scanned PDFs.
SCRUTINY_AI_VISION=true
# Maximum images / rasterized PDF pages per request, 1-10. Coarena permits 8.
SCRUTINY_AI_MAX_IMAGES=10
# OpenAI defaults to schema; compatible services default to json.
# Optional override: schema | json | prompt. All responses are validated locally.
# SCRUTINY_AI_JSON_MODE=json

# Local processing remains available independently of the selected cloud service.
SCRUTINY_LOCAL_MODEL=qwen3.5:4b
SCRUTINY_LOCAL_MODEL_URL=http://127.0.0.1:11434

# Older Gemini settings still work when the shared key/model above are blank.
GEMINI_API_KEY=
GEMINI_MODEL=
