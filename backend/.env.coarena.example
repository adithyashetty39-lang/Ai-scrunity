# Reference only: merge these settings into backend/.env, then restart.
# Keep your actual key private. Do not replace the whole existing .env blindly.
SCRUTINY_AI_PROVIDER=openai_compatible
SCRUTINY_AI_BASE_URL=https://coarena.ai/api/v1
SCRUTINY_AI_KEY=REPLACE_WITH_YOUR_COARENA_KEY
SCRUTINY_AI_MODEL=deepseek-v4-1-flash-1017
# Coarena lists this selected model as accepting images (checked 14 Nov 2026).
# Start with a synthetic connection test, then a non-confidential scan.
SCRUTINY_AI_VISION=true
SCRUTINY_AI_MAX_IMAGES=8
# Most portable initial mode: request JSON in the prompt and validate locally.
# Switch to json/schema only if that model and endpoint support response_format.
SCRUTINY_AI_JSON_MODE=prompt
